ime\n        string status\n        bigint approved_by FK\n    }\n    announcements {\n        bigint id PK\n        bigint created_by FK\n        string title\n        text content\n        string type\n        datetime published_at\n    }\n    notifications {\n        bigint id PK\n        bigint user_id FK\n        string title\n        text message\n        datetime read_at\n    }\n&quot;&#xa;}" id="2">
